# Copier ce fichier en .env.local puis renseigner les valeurs.
# Ne jamais commiter .env.local.

# Projet Supabase (Project Settings > API). Ces deux valeurs sont publiques par conception :
# la protection des données repose sur les règles RLS, pas sur le secret de cette clé.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Seulement pour ./scripts/test-rls.sh : deux comptes réservés aux tests, créés dans
# Supabase (Authentication > Users). Inutiles pour lancer l'application.
RLS_A_EMAIL=
RLS_A_PASSWORD=
RLS_B_EMAIL=
RLS_B_PASSWORD=

# IA de notation. Vide = réponses simulées (MockScorer), aucun appel réseau.
# Le jour où un vrai modèle est branché, cette clé se renseigne côté serveur uniquement
# (variable d'environnement Vercel), jamais avec le préfixe VITE_.
AI_API_KEY=
